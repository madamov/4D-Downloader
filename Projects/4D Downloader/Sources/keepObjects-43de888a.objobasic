Sub btnFillCredentials_MouseDown(x As Double, y As Double, button As MouseButton)
Var js As String

# fill email field
js = "emailInput = document.getElementById('store2018_login_email');"
js = js + "emailInput.value = '" + App.Account4D + "';"
Browser.ExecuteJavaScript(js)

#fill password field
js = "passwordInput = document.getElementById('store2018_login_password');"
js = js + "passwordInput.value = '" + App.Password4D + "';"
Browser.ExecuteJavaScript(js)

#click on Login button
js = "loginButton = document.getElementById('store2018_login_btnLogin'); loginButton.click();"
Browser.ExecuteJavaScript(js)

Var loginLink As String = "https://account.4d.com/4DACTION/webAccount_Login?lang=en&returnURL=https%3A//product-download.4d.com/"

End Sub

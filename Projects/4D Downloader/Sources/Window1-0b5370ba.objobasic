  Function Browser_DownloadRequested(download As HTMLViewerDownload) As Boolean
Var fileName As String = download.SuggestedFileName
Var destination As FileSystemItem = SpecialFolder.Downloads.Child(fileName)

If SpecialFolder.Downloads <> Nothing Then




download.SaveTo(destination)

End If

Return False
  End Function
  Sub Browser_DownloadFinished(download As HTMLViewerDownload)
Select Case download.State

Case HTMLViewerDownloadState.Completed

If download.Destination <> Nothing Then

MessageBox("Download ok")

End If

Case HTMLViewerDownloadState.Failed

MessageBox("Download failed")

End Select

  End Sub
End Class
  Sub Browser_NavigationFinished(url As String, success As Boolean)
Var js As String

URL_Display.Text = Browser.Source

print(url)

Select Case url

Case "https://account.4d.com/en/login.shtml"

print("Filling credentials")

js = "emailInput = document.getElementById('store2018_login_email');"
js = js + "passwordInput = document.getElementById('store2018_login_password');"
js = js + "emailInput.value = '" + App.Account4D
js = js + "'; passwordInput.value = '" + App.Password4D + "';"

Browser.ExecuteJavaScript(js)

print("logging in")

js = "loginButton = document.getElementById('store2018_login_btnLogin'); loginButton.click();"

Browser.ExecuteJavaScript(js)


Case "https://account.4d.com/"

print("logged in")

Browser.LoadURL("https://product-download.4d.com")


Case "https://product-download.4d.com/"

print("about to download")

getFileAtIndex(App.filesDownloaded)


End Select

  End Sub
  Sub Browser_Opening()


Browser.DownloadPolicy = HTMLViewerDownloadPolicy.DownloadsFolder
Browser.LoadURL("https://account.4d.com/en/login.shtml")

  End Sub
  Function Browser_DownloadRequested(download As HTMLViewerDownload) As Boolean
Var fileName As String = download.SuggestedFileName
Var destination As FileSystemItem = SpecialFolder.Downloads.Child(fileName)

If SpecialFolder.Downloads <> Nothing Then

print("Downloading " + fileName)

download.SaveTo(destination)

End If

Return False
  End Function
  Sub Browser_DownloadFinished(download As HTMLViewerDownload)
Select Case download.State

Case HTMLViewerDownloadState.Completed

If download.Destination <> Nothing Then

print("download of this file OK")

App.filesDownloaded = App.filesDownloaded + 1

If App.filesDownloaded >= App.fileList.Count Then
Var url As String
url="https://account.4d.com/4DACTION/webAccount_Logout?returnURL=https%3A//product-download.4d.com/user/logout"
Browser.LoadURL(url)
System.Quit()
Else
# continue downloading next file in a list
Browser.LoadURL("https://product-download.4d.com")
End If

End If

Case HTMLViewerDownloadState.Failed

print("DOWNLOAD FAILED for this file!")

End Select

  End Sub
  Public Sub GetOneFile(url As String)
Var js As String

js = "const a = document.createElement('a'); a.href = '"
js = js + url + "'; a.click();"

Browser.ExecuteJavaScript(js)

  End Sub
  Sub Browser_DownloadProgressed(download As HTMLViewerDownload)
If download.TotalBytes > 0 Then

Status.Text = download.SuggestedFileName + ": " + download.BytesReceived.ToString() + " of " + download.TotalBytes.ToString()

Else

Status.Text = download.SuggestedFileName + ": " + download.BytesReceived.ToString() + " bytes received"

End If

print(Status.Text)

  End Sub
  Sub btnLogout_MouseDown(x As Double, y As Double, button As MouseButton)
Var url As String

url="https://account.4d.com/4DACTION/webAccount_Logout?returnURL=https%3A//product-download.4d.com/user/logout"

Browser.LoadURL(url)

  End Sub
  Public Sub getFileAtIndex(idx As Integer)
Var filesToDownload() As String
Var filename As String

For i As Integer = 0 To App.fileList.Count - 1
filesToDownload.Append(App.fileList.ValueAt(i).StringValue)
Next i


If (App.fileList.Count > 0) Then

filename = App.fileList.ValueAt(idx).StringValue

print("Downloading " + filename)

Var myjs As String

myjs = "const a = document.createElement('a'); a.href = '" + filename + "'; a.click();"

Browser.ExecuteJavaScript(myjs)

End If

  End Sub
End Class
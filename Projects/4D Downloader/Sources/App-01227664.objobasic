Class App Inherits DesktopApplication

  Event Opening(args() As String)
Var parser As New CommandLineParser("Pass your 4D account and password.")


@If DebugBuild Then

Var myFile As FileSystemItem = New FileSystemItem("/Volumes/Radni/madamov/Documents_local/login_info.json")
Var jsonString As String = myFile.ReadAllText()
Var json As JSONItem = JSONItem.Parse(jsonString)

Var password As String = json.Value("password").StringValue
Var account As String = json.Value("account").StringValue
Var fileList As JSONItem = json.Value("filelist")

App.Account4D = account
App.Password4D = password
App.fileList = fileList

@Else

parser.AppVersion = Application.Version

parser.AddStringOption("username", "u", "4D Account")
parser.AddStringOption("password", "p", "Your 4D account password")
parser.AddStringOption("filelist", "l", "JSON listing files to download")
Var ok As Boolean = parser.Parse(args)

If ok Then
Print("in ok")

Var account As String = parser.StringValue("username")
Var password As String = parser.StringValue("password")

App.Account4D = account
App.Password4D = password

Var jsonTxt As String = parser.StringValue("filelist")

If jsonTxt.Length > 0 Then
Var json As JSONItem = JSONItem.Parse(jsonText)
App.fileList = json
End If

End If

Else

For Each msg As String In parser.Errors
System.ErrorPrint(msg)
Next

System.Quit(1)

End If

@EndIf

  End Event
  Public Property Account4D As String
  Public Property Password4D As String
  Public Property fileList As JSONItem
  Public Shared Property filesDownloaded As Integer = 0
End Class
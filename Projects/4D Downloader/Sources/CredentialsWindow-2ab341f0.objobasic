Public Class CredentialsWindow Inherits Window

  Sub btnLogin_Pressed()
If (inpAccount.Text <> "") And (inpPassword.Text <> "") Then

App.Account4D = inpAccount.Text
App.Password4D = inpPassword.Text

Self.Close()

Else

Var msgBox As New MessageDialog

msgBox.Message = "Account and/or password can't be empty"
msgBox.Title = "Credentials Entry Alert"
msgBox.ActionButtonCaption = "Understood"
msgBox.Icon = MessageDialogIcon.Caution
msgBox.Show()


End If

  End Sub
  Sub btnCancel_Pressed()
Self.Close()


  End Sub
End Class